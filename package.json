{
  "name": "ashfall-survival",
  "version": "1.0.0",
  "description": "Top-down survival game where enemies profile your tactics and adapt their counters.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "deploy": "node scripts/deploy-pages.mjs",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "gifenc": "^1.0.3",
    "globals": "^17.14.0",
    "pngjs": "^7.0.0",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "lucide": "^1.69.0"
  }
}
